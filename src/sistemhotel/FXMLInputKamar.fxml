<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane id="AnchorPane" prefHeight="310.0" prefWidth="420.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sistemhotel.FXMLInputKamarController">
   <children>
      <Label layoutX="35.0" layoutY="20.0" text="Kelola Data Kamar">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Label layoutX="35.0" layoutY="70.0" text="Nomor Kamar" />
      <TextField fx:id="txtnomor" layoutX="150.0" layoutY="66.0" prefWidth="230.0" promptText="Contoh: 101, 201" />
      <Label layoutX="35.0" layoutY="112.0" text="Tipe Kamar" />
      <ComboBox fx:id="cbTipe" layoutX="150.0" layoutY="108.0" prefWidth="230.0" promptText="-- Pilih Tipe Kamar --" />
      <Label layoutX="35.0" layoutY="154.0" text="Lantai" />
      <TextField fx:id="txtlantai" layoutX="150.0" layoutY="150.0" prefWidth="230.0" promptText="Contoh: 1, 2, 3" />
      <Label layoutX="35.0" layoutY="196.0" text="Status Kamar" />
      <ComboBox fx:id="cbStatus" layoutX="150.0" layoutY="192.0" prefWidth="230.0" promptText="-- Pilih Status --" />
      <Button fx:id="btnSimpan" layoutX="150.0" layoutY="250.0" mnemonicParsing="false" onAction="#btnSimpanKlik" prefWidth="80.0" text="Simpan" />
      <Button fx:id="btnBatal" layoutX="240.0" layoutY="250.0" mnemonicParsing="false" onAction="#btnBatalKlik" prefWidth="80.0" text="Batal" />
   </children>
</AnchorPane>
