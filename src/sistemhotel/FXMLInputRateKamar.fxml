<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane id="AnchorPane" prefHeight="350.0" prefWidth="440.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sistemhotel.FXMLInputRateKamarController">
   <children>
      <Label layoutX="35.0" layoutY="20.0" text="Kelola Data Rate Kamar">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Label layoutX="35.0" layoutY="70.0" text="ID Rate" />
      <TextField fx:id="txtidrate" layoutX="160.0" layoutY="66.0" prefWidth="240.0" promptText="Contoh: RATE-STD-01" />
      <Label layoutX="35.0" layoutY="110.0" text="Tipe Kamar" />
      <ComboBox fx:id="cbTipe" layoutX="160.0" layoutY="106.0" prefWidth="240.0" promptText="-- Pilih Tipe Kamar --" />
      <Label layoutX="35.0" layoutY="150.0" text="Nama Rate" />
      <TextField fx:id="txtnama" layoutX="160.0" layoutY="146.0" prefWidth="240.0" promptText="Contoh: Regular Rate, Weekend" />
      <Label layoutX="35.0" layoutY="190.0" text="Harga per Malam" />
      <TextField fx:id="txtharga" layoutX="160.0" layoutY="186.0" prefWidth="240.0" promptText="Contoh: 350000" />
      <Label layoutX="35.0" layoutY="230.0" text="Keterangan" />
      <TextField fx:id="txtketerangan" layoutX="160.0" layoutY="226.0" prefWidth="240.0" promptText="Keterangan tarif..." />
      <Button fx:id="btnSimpan" layoutX="160.0" layoutY="285.0" mnemonicParsing="false" onAction="#btnSimpanKlik" prefWidth="80.0" text="Simpan" />
      <Button fx:id="btnBatal" layoutX="250.0" layoutY="285.0" mnemonicParsing="false" onAction="#btnBatalKlik" prefWidth="80.0" text="Batal" />
   </children>
</AnchorPane>
