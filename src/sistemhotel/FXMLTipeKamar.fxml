<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane id="AnchorPane" prefHeight="480.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sistemhotel.FXMLTipeKamarController">
   <children>
      <Label layoutX="40.0" layoutY="20.0" text="Data Master Tipe Kamar">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <TextField fx:id="txtCari" layoutX="40.0" layoutY="58.0" onKeyReleased="#txtCariKeyTyped" prefHeight="25.0" prefWidth="210.0" promptText="Cari tipe kamar..." />
      <Button fx:id="btnCari" layoutX="258.0" layoutY="58.0" mnemonicParsing="false" onAction="#btnCariKlik" text="Cari" />
      <Button fx:id="btnTambah" layoutX="420.0" layoutY="58.0" mnemonicParsing="false" onAction="#btnTambahKlik" prefWidth="65.0" text="Tambah" />
      <Button fx:id="btnUbah" layoutX="492.0" layoutY="58.0" mnemonicParsing="false" onAction="#btnUbahKlik" prefWidth="65.0" text="Ubah" />
      <Button fx:id="btnHapus" layoutX="564.0" layoutY="58.0" mnemonicParsing="false" onAction="#btnHapusKlik" prefWidth="65.0" text="Hapus" />
      <TableView fx:id="tbvtipekamar" layoutX="40.0" layoutY="95.0" prefHeight="320.0" prefWidth="590.0">
        <columns>
          <TableColumn fx:id="colIdTipe" prefWidth="80.0" text="ID Tipe" />
          <TableColumn fx:id="colNamaTipe" prefWidth="150.0" text="Nama Tipe" />
          <TableColumn fx:id="colKapasitas" prefWidth="80.0" text="Kapasitas" />
          <TableColumn fx:id="colDeskripsi" prefWidth="275.0" text="Deskripsi Fasilitas" />
        </columns>
      </TableView>
      <Label layoutX="645.0" layoutY="70.0" text="Foto / Gambar Kamar:" />
      <ImageView fx:id="imgtipekamar" fitHeight="320.0" fitWidth="180.0" layoutX="645.0" layoutY="95.0" pickOnBounds="true" preserveRatio="true" />
      <Button fx:id="btnFirst" layoutX="40.0" layoutY="428.0" mnemonicParsing="false" onAction="#btnFirstKlik" prefWidth="55.0" text="First" />
      <Button fx:id="btnPrev" layoutX="102.0" layoutY="428.0" mnemonicParsing="false" onAction="#btnPrevKlik" prefWidth="55.0" text="Prev" />
      <Button fx:id="btnNext" layoutX="164.0" layoutY="428.0" mnemonicParsing="false" onAction="#btnNextKlik" prefWidth="55.0" text="Next" />
      <Button fx:id="btnLast" layoutX="226.0" layoutY="428.0" mnemonicParsing="false" onAction="#btnLastKlik" prefWidth="55.0" text="Last" />
   </children>
</AnchorPane>
