<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane id="AnchorPane" prefHeight="480.0" prefWidth="680.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sistemhotel.FXMLKamarController">
   <children>
      <Label layoutX="35.0" layoutY="20.0" text="Data Master Kamar">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <TextField fx:id="txtCari" layoutX="35.0" layoutY="58.0" onKeyReleased="#txtCariKeyTyped" prefHeight="25.0" prefWidth="200.0" promptText="Cari no kamar / tipe..." />
      <Button fx:id="btnCari" layoutX="242.0" layoutY="58.0" mnemonicParsing="false" onAction="#btnCariKlik" text="Cari" />
      <Button fx:id="btnTambah" layoutX="435.0" layoutY="58.0" mnemonicParsing="false" onAction="#btnTambahKlik" prefWidth="65.0" text="Tambah" />
      <Button fx:id="btnUbah" layoutX="507.0" layoutY="58.0" mnemonicParsing="false" onAction="#btnUbahKlik" prefWidth="65.0" text="Ubah" />
      <Button fx:id="btnHapus" layoutX="579.0" layoutY="58.0" mnemonicParsing="false" onAction="#btnHapusKlik" prefWidth="65.0" text="Hapus" />
      <TableView fx:id="tbvkamar" layoutX="35.0" layoutY="95.0" prefHeight="320.0" prefWidth="610.0">
        <columns>
          <TableColumn fx:id="colNomorKamar" prefWidth="120.0" text="Nomor Kamar" />
          <TableColumn fx:id="colIdTipe" prefWidth="150.0" text="ID / Tipe Kamar" />
          <TableColumn fx:id="colLantai" prefWidth="100.0" text="Lantai" />
          <TableColumn fx:id="colStatus" prefWidth="150.0" text="Status" />
        </columns>
      </TableView>
      <Button fx:id="btnFirst" layoutX="35.0" layoutY="428.0" mnemonicParsing="false" onAction="#btnFirstKlik" prefWidth="55.0" text="First" />
      <Button fx:id="btnPrev" layoutX="97.0" layoutY="428.0" mnemonicParsing="false" onAction="#btnPrevKlik" prefWidth="55.0" text="Prev" />
      <Button fx:id="btnNext" layoutX="159.0" layoutY="428.0" mnemonicParsing="false" onAction="#btnNextKlik" prefWidth="55.0" text="Next" />
      <Button fx:id="btnLast" layoutX="221.0" layoutY="428.0" mnemonicParsing="false" onAction="#btnLastKlik" prefWidth="55.0" text="Last" />
   </children>
</AnchorPane>
